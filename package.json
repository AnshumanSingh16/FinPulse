{
  "name": "finpulse",
  "private": true,
  "description": "FinPulse: an agentic AI financial copilot \u2014 \"Can I afford this, and what should I do next?\"",
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "npm run dev -w @finpulse/web",
    "build": "npm run build -w @finpulse/web",
    "lint": "npm run lint -w @finpulse/web",
    "typecheck": "npm run typecheck -w @finpulse/web",
    "test": "npm run test -w @finpulse/web",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1"
  }
}
