{
  "name": "@finpulse/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "API contract shared by backend and frontend: the OpenAPI document exported from FastAPI and TypeScript types generated from it.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./openapi.json": "./openapi.json"
  },
  "types": "./src/index.ts",
  "scripts": {
    "generate": "openapi-typescript ./openapi.json -o ./src/schema.gen.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3"
  }
}
