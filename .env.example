# FinPulse local configuration.
# Copy to `.env` in the repository root (`cp .env.example .env`). Both the API and the web app
# read this one file. `.env` is git-ignored. Never commit real credentials.

# ---------------------------------------------------------------------------
# Shared
# ---------------------------------------------------------------------------
# development | test | staging | production
FINPULSE_ENV=development

# ---------------------------------------------------------------------------
# Backend (apps/api)
# ---------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
# Comma-separated browser origins allowed to call the API (the web app's URL).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# console (human-readable, for local dev) | json (one JSON object per line, for deployments)
LOG_FORMAT=console

# PostgreSQL. The default matches infra/docker-compose.yml (`make db-up`).
# A Supabase connection string (postgres://… or postgresql://…) works as-is.
DATABASE_URL=postgresql://finpulse:finpulse@localhost:5432/finpulse
DATABASE_POOL_SIZE=5
DATABASE_CONNECT_TIMEOUT_S=3

# Optional: enables the database tests in `uv run pytest`. Use a throwaway database.
# TEST_DATABASE_URL=postgresql://finpulse:finpulse@localhost:5432/finpulse_test

# AI agents (Claude). Optional: without a key the deterministic API works fully and the agent
# endpoints return 503 llm_unavailable. Put your real key only in `.env`, never here.
# ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
LLM_EFFORT=high
LLM_MAX_TOKENS=16000
LLM_TIMEOUT_S=300
LLM_MAX_RETRIES=2
# Retry a safety-declined request on Anthropic's recommended fallback model (Claude API only).
LLM_REFUSAL_FALLBACK=true

# Investigations kept for GET /api/v1/investigations; optionally also saved as JSON files.
INVESTIGATIONS_KEEP=50
# INVESTIGATIONS_DIR=investigations
# Investigations allowed to run at once per organisation (each makes several paid LLM calls).
INVESTIGATIONS_MAX_RUNNING=2

# --- Security (SECURITY.md) -------------------------------------------------
# API keys, as name:role:sha256[:org_uuid] entries, comma-separated. Roles: viewer < analyst <
# admin. Generate with `cd apps/api && uv run finpulse auth new-key --name web --role admin`:
# it prints the key once (give it to the client) and this entry (only the hash goes here).
# Empty = authentication off, allowed only in development and test.
# API_KEYS=
# Largest request body the API accepts, in bytes.
MAX_REQUEST_BYTES=1000000
# Where the AI investigation audit trail is written: postgres | memory (tests only).
AUDIT_BACKEND=postgres

# ---------------------------------------------------------------------------
# Frontend (apps/web)
# ---------------------------------------------------------------------------
# Used by the Next.js server (server components and the same-origin proxy) to reach the API.
# The browser never calls the API directly.
FINPULSE_API_URL=http://127.0.0.1:8000
# The key the Next.js server sends when API_KEYS is set. Server-only: never NEXT_PUBLIC_.
# An analyst key runs investigations; the demo reset button needs an admin key.
# FINPULSE_API_KEY=

# ---------------------------------------------------------------------------
# Not used yet — added with the phase that needs them (see DEVELOPMENT_PLAN.md):
#   Supabase Auth (rest of Phase 0).
# ---------------------------------------------------------------------------
