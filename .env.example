# FinPulse local configuration.
# Copy to `.env` in the repository root (`cp .env.example .env`). Both the API and the web app
# read this one file. `.env` is git-ignored. Never commit real credentials.

# ---------------------------------------------------------------------------
# Shared
# ---------------------------------------------------------------------------
# development | test | staging | production
FINPULSE_ENV=development

# ---------------------------------------------------------------------------
# Backend (apps/api)
# ---------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
# Comma-separated browser origins allowed to call the API (the web app's URL).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# console (human-readable, for local dev) | json (one JSON object per line, for deployments)
LOG_FORMAT=console

# PostgreSQL. The default matches infra/docker-compose.yml (`make db-up`).
# A Supabase connection string (postgres://… or postgresql://…) works as-is.
DATABASE_URL=postgresql://finpulse:finpulse@localhost:5432/finpulse
DATABASE_POOL_SIZE=5
DATABASE_CONNECT_TIMEOUT_S=3

# Optional: enables the database tests in `uv run pytest`. Use a throwaway database.
# TEST_DATABASE_URL=postgresql://finpulse:finpulse@localhost:5432/finpulse_test

# ---------------------------------------------------------------------------
# Frontend (apps/web)
# ---------------------------------------------------------------------------
# Used by the Next.js server (server components) to reach the API.
FINPULSE_API_URL=http://127.0.0.1:8000
# Used by code running in the browser. Inlined at build time, so it must be public-safe.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Not used yet — added with the phase that needs them (see DEVELOPMENT_PLAN.md):
#   Supabase Auth (rest of Phase 0), LLM provider + API key (Phase 7).
# ---------------------------------------------------------------------------
