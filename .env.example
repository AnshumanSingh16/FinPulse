# Copy to .env and fill in. Real environment variables take precedence over this file.
# Never commit .env — it is in .gitignore.

# Optional. Without it, Ask FinPilot runs in rule-based mode (no AI, nothing leaves your machine).
ANTHROPIC_API_KEY=

# Optional overrides
# FINPILOT_MODEL=claude-opus-5-5
# FINPILOT_MAX_STEPS=8
# FINPILOT_DB=finpilot.db
# FINPILOT_AI=off        # force rule-based mode even when a key is set
