# Copy to .env and fill in (or set the key inside the app: Ask -> Set up AI). Real environment variables take precedence over this file.
# Never commit .env — it is in .gitignore.

# Optional. Without a key, Ask FinPilot uses built-in answers (no AI, nothing leaves your machine).
# Free option: a Google Gemini key from https://aistudio.google.com/apikey (starts with AIza or AQ.)
GEMINI_API_KEY=
# Or an Anthropic key (starts with sk-ant-)
ANTHROPIC_API_KEY=

# Optional overrides
# FINPILOT_PROVIDER=gemini         # gemini or anthropic, when both keys are set
# FINPILOT_GEMINI_MODEL=   (set automatically to a model your key can use)
# FINPILOT_MODEL=claude-opus-5-5
# FINPILOT_MAX_STEPS=8
# FINPILOT_DB=finpilot.db
# FINPILOT_AI=off        # force built-in answers even when a key is set
