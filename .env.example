# FinPulse settings. Everything here is OPTIONAL: the app runs fully without a .env file.
# `npm start` copies this file to `.env` on first run. Put real keys only in `.env` (git-ignored),
# never in this file.

# AI features (live rate research, AI explanations, the AI copilot, PDF reading).
# Without a key, FinPulse runs in a clearly labelled deterministic mode.
# ANTHROPIC_API_KEY=

# Model used for the AI features.
LLM_MODEL=claude-opus-5-5

# Effort for interactive AI calls: low | medium | high (default low, for speed).
# PERSONAL_LLM_EFFORT=low

# Force the no-AI mode even when a key is set (useful to rehearse an offline demo).
# FINPULSE_AI=off

# Keep AI on but use labelled illustrative financing ranges instead of live web search.
# FINPULSE_LIVE_RESEARCH=off

# Where your plan, analyses and check-ins are kept: file (default; one private JSON file per
# browser session, survives restarts) or memory (cleared on restart).
# FINPULSE_STORAGE=file
# FINPULSE_DATA_DIR=.finpulse-data
